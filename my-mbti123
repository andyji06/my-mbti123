<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI로 포켓몬 찾기 ⚡</title>
    <style>
        /* 기본 설정 및 폰트 정의 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --bg-primary: #FFFDF0;
            --bg-card: #FFFFFF;
            --accent-yellow: #FFDE00;
            --accent-dark-yellow: #E6C200;
            --accent-orange: #FF7A00;
            --accent-red: #FF4B4B;
            --text-main: #2C2C2C;
            --text-sub: #666666;
            --shadow-soft: 0 8px 24px rgba(220, 180, 80, 0.15);
            --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.08);
            --border-radius: 20px;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-image: radial-gradient(#FFE885 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }

        .container {
            width: 100%;
            max-width: 520px;
            background: var(--bg-card);
            border-radius: var(--border-radius);
            padding: 32px 24px;
            box-shadow: var(--shadow-soft);
            border: 3px solid #FFE885;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        /* 헤더 스타일 */
        header {
            margin-bottom: 28px;
        }

        .badge {
            display: inline-block;
            background-color: #FFF3B0;
            color: #8A6D00;
            font-weight: 700;
            font-size: 0.9rem;
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
        }

        h1 {
            font-size: 1.8rem;
            color: #3B3B3B;
            margin-bottom: 8px;
            word-break: keep-all;
        }

        p.subtitle {
            font-size: 1.05rem;
            color: var(--text-sub);
            word-break: keep-all;
        }

        /* 16개 MBTI 버튼 그리드 */
        .mbti-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 12px;
        }

        .mbti-btn {
            background-color: #FFFDF0;
            border: 2px solid #FFE066;
            border-radius: 14px;
            padding: 16px 8px;
            font-size: 1.1rem;
            font-weight: 800;
            color: #4A4A4A;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .mbti-btn:hover {
            background-color: #FFE885;
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(255, 200, 0, 0.25);
            border-color: #FFD000;
        }

        .mbti-btn:active {
            transform: translateY(0);
        }

        /* 결과 화면 디자인 */
        .result-container {
            display: none;
            animation: fadeIn 0.4s ease-out forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pokemon-card {
            background: linear-gradient(180deg, #FFFDF0 0%, #FFF9D6 100%);
            border-radius: 18px;
            padding: 24px 16px;
            border: 2px dashed #FFD54F;
            margin-bottom: 24px;
            position: relative;
        }

        .type-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            color: white;
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .pokemon-emoji {
            font-size: 5rem;
            line-height: 1.1;
            margin: 10px 0;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.1));
            animation: bounce 2s infinite ease-in-out;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .pokemon-title {
            font-size: 1.1rem;
            color: var(--accent-orange);
            font-weight: 700;
            margin-bottom: 4px;
        }

        .pokemon-name {
            font-size: 2rem;
            font-weight: 900;
            color: #222;
            margin-bottom: 16px;
        }

        .reason-box {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 16px;
            border-radius: 12px;
            font-size: 1.05rem;
            line-height: 1.6;
            color: #333;
            text-align: left;
            word-break: keep-all;
            border: 1px solid #FFE082;
        }

        /* 궁합 카드 */
        .match-card {
            background-color: #FFF8E1;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 24px;
            text-align: left;
            border: 1px solid #FFECB3;
        }

        .match-title {
            font-size: 0.95rem;
            font-weight: 800;
            color: #E65100;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .match-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .match-emoji {
            font-size: 2.5rem;
            background: #FFF;
            border-radius: 50%;
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #FFE082;
            flex-shrink: 0;
        }

        .match-info {
            flex-grow: 1;
        }

        .match-mbti-name {
            font-weight: 800;
            font-size: 1.1rem;
            color: #222;
        }

        .match-desc {
            font-size: 0.95rem;
            color: #555;
            margin-top: 2px;
            line-height: 1.4;
            word-break: keep-all;
        }

        /* 다시 고르기 버튼 */
        .btn-retry {
            width: 100%;
            background: linear-gradient(180deg, #FFDE00 0%, #F5B800 100%);
            border: none;
            border-radius: 14px;
            padding: 16px;
            font-size: 1.2rem;
            font-weight: 800;
            color: #333;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(245, 184, 0, 0.4);
            transition: all 0.2s ease;
        }

        .btn-retry:hover {
            background: linear-gradient(180deg, #FFE53B 0%, #FFC107 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(245, 184, 0, 0.5);
        }

        .btn-retry:active {
            transform: translateY(0);
        }

        /* 모바일 반응형 처리 */
        @media (max-width: 420px) {
            .mbti-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }
            .mbti-btn {
                padding: 14px 6px;
                font-size: 1rem;
            }
            h1 {
                font-size: 1.5rem;
            }
            .container {
                padding: 24px 16px;
            }
        }
    </style>
</head>
