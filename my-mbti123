                reason: '상황을 빠르게 파악하고 뛰어난 감각으로 문제를 직접 해결합니다. 조용하지만 도구를 다루거나 기술을 익히는 데 남다른 재능을 보입니다.',
                matchMbti: 'ESTJ',
                matchName: '윈디',
                matchEmoji: '🦁',
                matchDesc: '윈디의 명확한 리더십과 루카리오의 뛰어난 해결 능력이 완벽한 호흡을 자랑합니다.'
            },
            'ESFJ': {
                name: '라이츄',
                title: '친근함 만점 인싸 파트너',
                emoji: '⚡',
                type: '전기',
                reason: '다정다감한 성격으로 누구와도 쉽게 친해지며 그룹의 화합을 도모합니다. 주변 사람들을 세심하게 챙기고 함께하는 즐거움을 만끽합니다.',
                matchMbti: 'ISFP',
                matchName: '잠만보',
                matchEmoji: '💤',
                matchDesc: '잠만보의 온화하고 느긋한 태도가 라이츄의 바쁜 마음을 아늑하게 쉼터처럼 녹여줍니다.'
            },
            'ESTJ': {
                name: '윈디',
                title: '당당하고 공정한 리더',
                emoji: '🦁',
                type: '불꽃',
                reason: '질서와 규율을 중시하며 질주하듯 목표를 향해 무리를 이끕니다. 정직하고 추진력이 강하여 누구에게나 신뢰를 받는 멋진 대장입니다.',
                matchMbti: 'ISTP',
                matchName: '루카리오',
                matchEmoji: '🐺',
                matchDesc: '루카리오의 냉철한 실무 능력과 윈디의 확실한 지휘력이 모여 최고의 결과를 만듭니다.'
            }
        };

        // MBTI 목록 배열
        const mbtiList = [
            'INFP', 'INFJ', 'ENFP', 'ENTP',
            'INTJ', 'INTP', 'ENFJ', 'ENTJ',
            'ISFP', 'ISFJ', 'ESFP', 'ESTP',
            'ISTJ', 'ISTP', 'ESFJ', 'ESTJ'
        ];

        // 화면 초기화 및 버튼 생성
        window.onload = function() {
            const gridContainer = document.getElementById('mbti-grid');
            
            mbtiList.forEach(mbti => {
                const btn = document.createElement('button');
                btn.className = 'mbti-btn';
                btn.innerHTML = `<span>${mbti}</span>`;
                btn.onclick = () => selectMBTI(mbti);
                gridContainer.appendChild(btn);
            });
        };

        // MBTI 선택 시 결과 표시 Logic
        function selectMBTI(mbti) {
            const data = mbtiPokemonData[mbti];
            if (!data) return;

            // UI 데이터 바인딩
            document.getElementById('result-mbti-badge').innerText = `${mbti} 대표 포켓몬`;
            document.getElementById('pokemon-name').innerText = data.name;
            document.getElementById('pokemon-title').innerText = `"${data.title}"`;
            document.getElementById('pokemon-emoji').innerText = data.emoji;
            document.getElementById('pokemon-reason').innerText = data.reason;

            // 타입 배지 색상 적용
            const typeBadge = document.getElementById('pokemon-type');
            typeBadge.innerText = `${data.type} 타입`;
            typeBadge.style.backgroundColor = typeColors[data.type] || '#A8A878';

            // 궁합 데이터 적용
            document.getElementById('match-emoji').innerText = data.matchEmoji;
            document.getElementById('match-mbti-name').innerText = `${data.matchMbti} (${data.matchName})`;
            document.getElementById('match-desc').innerText = data.matchDesc;

            // 화면 전환 (선택 화면 숨기고 결과 화면 출력)
            document.getElementById('selection-screen').style.display = 'none';
            const resultScreen = document.getElementById('result-screen');
            resultScreen.style.display = 'block';

            // 스크롤 상단으로 이동
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 다시 고르기 동작
        function resetSelection() {
            document.getElementById('result-screen').style.display = 'none';
            document.getElementById('selection-screen').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
